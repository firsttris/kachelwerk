{
  "name": "kachelwerk",
  "version": "0.1.0",
  "description": "Kacheln für Home Assistant: Rollladen, Licht, Thermostat und mehr, aus MUI",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite demo --config vite.config.ts",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "shots": "node scripts/shots.mjs",
    "test:e2e": "playwright test --project=cards",
    "screenshots": "KACHELWERK_SCREENSHOTS=1 playwright test --project=screenshots"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@iconify-json/lucide": "^1.2.137",
    "@iconify/utils": "^3.1.7",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^26.6.3",
    "clsx": "^2.1.1",
    "happy-dom": "^20.14.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
